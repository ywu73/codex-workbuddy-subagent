{
  "name": "workbuddy-bridge-mcp-server",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run --exclude tests/workbuddy.e2e.test.ts",
    "native-adapter": "node dist/src/native-provider.js",
    "test:protocol": "vitest run tests/protocol.test.ts",
    "test:stdio": "npm run build && vitest run tests/stdio.test.ts",
    "test:e2e": "WORKBUDDY_E2E=1 vitest run tests/workbuddy.e2e.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.17.57",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
