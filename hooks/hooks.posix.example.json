{
  "description": "One-shot plaintext task handoff for the WorkBuddy-backed model-selectable workers.",
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "^(workbuddy_worker_hy3|workbuddy_worker_glm52|workbuddy_worker_minimax_m3|workbuddy_worker_kimi_k27)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/to/plaintext_handoff.py\" --mode hook",
            "timeout": 10,
            "statusMessage": "Delivering the staged WorkBuddy assignment",
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
